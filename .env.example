# GEMINI_API_KEY: Optional if AI features are added in the future.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Optional. If configured, BLESS METHOD persists users, jobs, and transactions to your Supabase project.
# If omitted, BLESS METHOD persists locally to disk (/app/applet/data/bless_db.json).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# STRIPE: Optional. For points purchasing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# GOOGLE OAUTH: Sign in with Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# DISCORD OAUTH: Sign in with Discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

